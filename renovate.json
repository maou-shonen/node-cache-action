{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>maou-shonen/.github:renovate-config"],
  "automergeStrategy": "squash",
  "postUpgradeTasks": {
    "commands": ["bun install --frozen-lockfile", "bun run build"],
    "fileFilters": ["dist/**"],
    "executionMode": "branch"
  },
  "packageRules": [
    {
      "description": "Automerge GitHub Actions including majors; CI exercises them",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": true
    },
    {
      "description": "Keep integration.yml on floating @v1 to test the published tag",
      "matchPackageNames": ["maou-shonen/node-cache-action"],
      "pinDigests": false
    },
    {
      "description": "Automerge non-major npm, pins, and lockfile maintenance",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "Automerge @types majors (compile-time only)",
      "matchPackageNames": ["@types/{/,}**"],
      "matchUpdateTypes": ["major"],
      "automerge": true
    },
    {
      "description": "minimatch override stays on v3; v10 drops CJS default export used by @actions/glob",
      "matchPackageNames": ["minimatch"],
      "allowedVersions": "<4"
    },
    {
      "description": "TypeScript 7 breaks ncc 0.38/0.45 ts-loader; reopen when ncc supports it",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
